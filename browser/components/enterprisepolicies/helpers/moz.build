with Files("**"):
    BUG_COMPONENT = ("Firefox", "Enterprise Policies")

EXTRA_JS_MODULES.policies += [
    "BookmarksPolicies.sys.mjs",
    "ProxyPolicies.sys.mjs",
    "WebsiteFilter.sys.mjs",
]

MOZ_SRC_FILES += [
    "AIChatbotPolicies.sys.mjs",
    "ContentAnalysisPolicies.sys.mjs",
]

if CONFIG["MOZ_ENTERPRISE"]:
    MOZ_SRC_FILES += [
        "SecurityLoggingPolicy.sys.mjs",
        "SyncPolicy.sys.mjs",
        "WatermarkChild.sys.mjs",
        "WatermarkParent.sys.mjs",
        "WatermarkPolicy.sys.mjs",
    ]
