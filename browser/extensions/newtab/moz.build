with Files("**"):
    BUG_COMPONENT = ("Firefox", "New Tab Page")

SPHINX_TREES["docs"] = "docs"

BROWSER_CHROME_MANIFESTS += [
    "test/browser/browser.toml",
]

PYTHON_UNITTEST_MANIFESTS += ["test/pytest/python.toml"]

XPCSHELL_TESTS_MANIFESTS += [
    "test/xpcshell/xpcshell.toml",
]

JAR_MANIFESTS += ["addon-jar.mn"]

if CONFIG["NODEJS"]:
    GeneratedFile(
        "newtab-node-modules.stamp",
        script="build-newtab-bundles.py",
        entry_point="ensure_node_modules",
        force=True,
    )

    GeneratedFile(
        "data/content/vendor.bundle.js",
        "data/content/activity-stream.bundle.js",
        script="build-newtab-bundles.py",
        entry_point="generate_js",
        inputs=["!newtab-node-modules.stamp"],
    )

    GeneratedFile(
        "css/activity-stream.css",
        "css/nova/activity-stream.css",
        script="build-newtab-bundles.py",
        entry_point="generate_css",
        inputs=["!newtab-node-modules.stamp"],
    )

DIRS += ["webext-glue"]
