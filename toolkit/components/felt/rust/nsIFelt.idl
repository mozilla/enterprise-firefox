#include "nsISupports.idl"
#include "nsICookie.idl"

[scriptable, uuid(48fc7a4c-058a-4231-8650-83160ee20cb9)]
interface nsIFelt : nsISupports {
  const unsigned long FeltEncryptionExitCode_Archive = 0x93;
  const unsigned long FeltEncryptionExitCode_Delete = 0x94;
  // The spawned browser could not unlock its profile: the internal (SDR) token
  // could not be logged in (no primarySecret, or a rejected/rotated secret).
  // Exit with this code rather than run against a profile it cannot decrypt
  // (Bug 2021342).
  const unsigned long FeltEncryptionExitCode_SdrTokenUnlockFailed = 0x95;

  [must_use]
  ACString oneShotIpcServer();

  [must_use]
  AString binPath();

  [must_use]
  boolean makeBackgroundProcess(in boolean background);

  [must_use]
  boolean isFeltUI();

  [must_use]
  boolean isFeltBrowser();

  [must_use]
  boolean isFeltSafeMode();

  /**
   * Verify the connecting IPC peer against the browser felt spawned and, only
   * if it matches, retain the channel over which the managed secret and other
   * state are sent. The caller passes the OS process id of the process running
   * as the browser: the spawned process itself or, on Windows, the browser
   * child the launcher process creates and announces to felt. On platforms
   * whose transport attests a peer pid, an unrelated same-user process that
   * races to connect has a different pid and is refused.
   */
  [must_use]
  void ipcChannel(in unsigned long pid, in unsigned long browserGeneration);

  [must_use]
  void sendBoolPreference(in ACString name, in boolean value);

  [must_use]
  void sendStringPreference(in ACString name, in ACString value);

  [must_use]
  void sendIntPreference(in ACString name, in int32_t value);

  [must_use]
  void sendCookies(in Array<nsICookie> cookies);

  [must_use]
  void sendReady();

  [must_use]
  void sendRestartForced();

  [must_use]
  void sendUpdateReady();

  [must_use]
  void sendAccessToken();

  [must_use]
  void refreshTokens();

  [must_use]
  ACString getRefreshToken();

  [must_use]
  ACString getAccessTokenIfValid();

  // expires_at is a Unix timestamp in seconds (UTC).
  [must_use]
  void setTokens(in ACString access_token, in ACString refresh_token, in long long expires_at);

  [must_use]
  void clearTokens();

  /**
   * Send the console-supplied primarySecret (64-char hex) to the spawned
   * Firefox over the existing Felt IPC channel. The Felt UI process fetches it
   * via ConsoleClient.getPrimarySecret() and calls this right after spawning
   * Firefox. The secret is never stored on the Felt side: the browser hands it
   * straight to storage/SQLiteEncryption.cpp on receipt. Must be sent BEFORE
   * the spawned Firefox initializes mozStorage encryption (the storage layer
   * blocks at `profile-do-change` waiting for it), so it is sent ahead of
   * `sendAccessToken()` / `sendReady()`.
   */
  [must_use]
  void sendPrimarySecret(in ACString hex);

  [must_use]
  void sendFeltReady();

  [must_use]
  void openURL(in ACString url, in long disposition);

  [must_use]
  ACString getConsoleUrl();

  [must_use]
  void performSignout();

  /**
   * Called by the spawned Firefox to tell the Felt UI process whether shutting
   * the browser down locks the session (persists the refresh token behind OS
   * auth to resume later) rather than signing out. The value is cached on the
   * browser's IPC client and attached to the Exiting message when a shutdown
   * is observed, so it must be kept in sync with the locking pref (see
   * EnterpriseHandler). Because the intent travels with the exit itself, a
   * quit vetoed by a beforeunload handler leaves nothing to undo.
   */
  void setShutdownLockIntent(in boolean lockIntent);

  /**
   * Called by the spawned Firefox to tell the Felt UI process whether the
   * session should be locked (rather than signed out) when a restart applies a
   * pending update. The value is cached on the browser's IPC client and read
   * when a restart-quit is observed, so it must be kept in sync with the restart
   * locking pref (see EnterpriseHandler). The Felt UI only acts on it when the
   * restart is actually applying an update, since an in-place restart keeps the
   * session in memory.
   */
  void setRestartLockIntent(in boolean lockIntent);

  /**
   * Called by the spawned Firefox to relay whether the session should be
   * locked (rather than discarded) when repeated crashes abort the automatic
   * restart. The browser owns the `enterprise.locking.crash` pref, which the
   * Felt UI process cannot read, and it is dead by the time the crash
   * decision is made, so the value must be relayed while the session is
   * alive: once at startup and again on every pref change. Sends a
   * CrashLockIntent message over the Felt IPC channel, which the Felt UI
   * process turns into a `felt-firefox-crash-lock-intent` observer
   * notification. Returns a failure nsresult (throwing on the caller side) if
   * the IPC client is not available or the message could not be sent.
   */
  [must_use]
  void setCrashLockIntent(in boolean lockIntent);

  [must_use]
  void shutdownFirefox();

  [must_use]
  void requestUpdateCheck();
};
