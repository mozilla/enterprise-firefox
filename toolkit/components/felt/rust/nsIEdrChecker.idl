#include "nsISupports.idl"

/**
 * Detects which well-known Endpoint Detection and Response (EDR) agents are
 * running on the system. The catalog of known agents is defined internally;
 * callers do not enumerate or hardcode it.
 */
[scriptable, uuid(b7e4d2a0-3f15-4c8e-9a6b-2d1e5f7c0a93)]
interface nsIEdrChecker : nsISupports {
  /**
   * @returns the identifiers of the EDR agents detected as running
   *          (e.g. "crowdstrike", "sentinelone").
   */
  Array<ACString> getPresentEdrs();
};

%{C++
#define NS_EDR_CHECKER_CONTRACTID "@mozilla.org/enterprise/edr-checker;1"
%}
