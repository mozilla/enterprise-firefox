    "PackageKitUpdateService.sys.mjs",
]

FINAL_LIBRARY = "xul"

CXXFLAGS += CONFIG["GLIB_CFLAGS"]
CXXFLAGS += CONFIG["MOZ_GTK3_CFLAGS"]
